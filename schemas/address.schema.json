{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crm/address.schema.json",
  "title": "Address — endereço reutilizável",
  "type": "object",
  "additionalProperties": false,
  "required": ["city", "state"],
  "properties": {
    "street": { "type": "string", "maxLength": 200 },
    "number": { "type": "string", "maxLength": 20 },
    "complement": { "type": ["string", "null"], "maxLength": 80 },
    "district": { "type": "string", "maxLength": 80 },
    "city": { "type": "string", "minLength": 2, "maxLength": 80 },
    "state": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "zip": { "type": "string", "pattern": "^[0-9]{8}$" }
  }
}
