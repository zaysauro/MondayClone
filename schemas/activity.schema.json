{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crm/activity.schema.json",
  "title": "Activity — interação, visita ou tarefa",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "userId", "title", "createdAt", "updatedAt"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "type": { "$ref": "crm/enums.json#/definitions/ActivityType" },
    "dealId": { "type": ["string", "null"], "format": "uuid" },
    "leadId": { "type": ["string", "null"], "format": "uuid" },
    "personId": { "type": ["string", "null"], "format": "uuid" },
    "propertyId": { "type": ["string", "null"], "format": "uuid" },
    "userId": { "type": "string", "format": "uuid" },
    "title": { "type": "string", "minLength": 2, "maxLength": 160 },
    "body": { "type": ["string", "null"], "maxLength": 4000 },
    "dueAt": { "type": ["string", "null"], "format": "date-time" },
    "doneAt": { "type": ["string", "null"], "format": "date-time" },
    "outcome": { "type": ["string", "null"], "maxLength": 500 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "anyOf": [
    { "required": ["dealId"] },
    { "required": ["leadId"] },
    { "required": ["personId"] }
  ]
}
